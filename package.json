{
  "name": "dom-cfg-extractor",
  "version": "1.0.0",
  "description": "Extract DOM data via JSON config. Change config, not code, when structure changes.",
  "license": "ISC",
  "author": "Jayhoo",
  "keywords": [
    "spider",
    "DOM",
    "extractor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayhooHwang/dom-cfg-extractor.git"
  },
  "bugs": {
    "url": "https://github.com/JayhooHwang/dom-cfg-extractor/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
